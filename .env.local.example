# ── Supabase (production / Vercel) ─────────────────────────────
# When these are set, the app uses Supabase Postgres + Storage.
# Leave them empty for local file-based development.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ───────────────────────────────────────────────────────
# Long random string used to sign session cookies.
AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated list of emails allowed to log in.
ADMIN_EMAILS=info@nextviro.com
